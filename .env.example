# --- Required in production ---
ADMIN_PASSWORD=choose-a-strong-password
AUTH_SECRET=any-long-random-string

# --- Optional: gate the candidate start page with a code you share ---
TEST_ACCESS_CODE=

# --- Persistence (add Upstash Redis from Vercel Marketplace; these are injected automatically) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Legacy Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN are also supported)
